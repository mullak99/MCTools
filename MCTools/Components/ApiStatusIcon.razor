@using MCTools.SDK.Models

<MudItem Class="mt-1">
	@switch (Status.Status)
	{
		case SDK.Enums.Controllers.Status.Healthy:
			<MudTooltip Placement="Placement.Top" Text="The API is healthy. Everything should work as intended!">
				<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Title="Healthy" />
			</MudTooltip>
			break;
		case SDK.Enums.Controllers.Status.Degraded:
			<MudTooltip Placement="Placement.Top" Text="The API is degraded. Some of the web app functions will fail!">
				<MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Title="Degraded" />
			</MudTooltip>
			break;
		case SDK.Enums.Controllers.Status.Unhealthy:
			<MudTooltip Placement="Placement.Top" Text="The API is unhealthy. Most of the web app functions will fail!">
				<MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Title="Unhealthy" />
			</MudTooltip>
			break;
		case SDK.Enums.Controllers.Status.Unknown:
		default:
			<MudTooltip Placement="Placement.Top" Text="The API status is unknown. This should change in a few seconds.">
				<MudIcon Icon="@Icons.Material.Filled.Help" Color="Color.Info" Title="Unknown" />
			</MudTooltip>
			break;
	}
</MudItem>

@code {
	[Parameter] public MCToolsHealthStatus Status { get; set; } = MCToolsHealthStatus.Unknown;
}
